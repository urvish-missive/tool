{
  "name": "missive-seo-content-qa-extension",
  "private": true,
  "version": "1.0.0",
  "description": "Chrome extension (Manifest V3) for the Missive SEO Content QA tool",
  "type": "module",
  "scripts": {
    "dev": "vite build --watch --mode development",
    "build": "tsc --noEmit && vite build --mode production",
    "build:extension": "npm run build",
    "preview": "vite --mode development",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@fontsource/rubik": "^5.2.5",
    "lucide-react": "^1.38.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.8",
    "@types/chrome": "^0.0.326",
    "@types/node": "^24.19.1",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.5.2",
    "jsdom": "^26.1.0",
    "tailwindcss": "^4.1.8",
    "typescript": "^5.8.3",
    "vite": "^6.3.5",
    "vitest": "^5.0.3"
  }
}
