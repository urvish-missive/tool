PORT=5000
DATABASE_URL="mongodb+srv://<username>:<password>@<cluster>.mongodb.net/seo-analyzer?retryWrites=true&w=majority"

# AI Providers (set one or both — Groq is used as fallback if Gemini fails)
AI_PROVIDER=gemini
AI_API_KEY=your_gemini_api_key_here
GROQ_API_KEY=your_groq_api_key_here
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=google/gemini-2.5-flash

# Optional: override model names
# GEMINI_MODEL=gemini-3.7-flash
# GROQ_MODEL=llama-3.3-70b-versatile

# Client origins allowed by CORS (supports comma-separated list or *; localhost, 127.0.0.1, *.missivedigital.com, *.vercel.app are automatically allowed)
# Example: CLIENT_URL=http://localhost:5173,https://tools.missivedigital.com
CLIENT_URL=http://localhost:5173
RATE_LIMIT_WINDOW_MS=3600000
RATE_LIMIT_MAX_REQUESTS=10

# Admin Authentication (Required in production: minimum 32 characters)
JWT_SECRET=your_super_secret_jwt_key_at_least_32_characters_long

# Initial Super-Admin Account (used only if database contains 0 admin accounts)
# In production, ADMIN_INITIAL_PASSWORD must be at least 12 characters and not 'admin123'
ADMIN_INITIAL_EMAIL=admin@missivedigital.com
ADMIN_INITIAL_PASSWORD=your_strong_initial_admin_password_min_12_chars

# ── Hub & Spoke Planner (/blog-topic-generator) ──
# Uses the AI provider keys above (AI_API_KEY, GROQ_API_KEY, OPENROUTER_API_KEY, ZEN_API_KEY)
# open = every visitor gets website scan, file upload, outlines, drafts and the strategy summary; paid = locked
HUB_SPOKE_ACCESS=open
# Who gets the strategy summary when HUB_SPOKE_ACCESS=paid: paid | lead | free
HUB_SPOKE_SUMMARY_ACCESS=paid
# Read the visitor's website and sitemap when they enter one
FETCH_URLS=true
# Per-IP hourly limits
HUB_SPOKE_PLANS_PER_HOUR=5
HUB_SPOKE_OUTLINES_PER_HOUR=20
HUB_SPOKE_DRAFTS_PER_HOUR=10
# Web research for drafts (https://tavily.com). Without it, statistics stay as placeholders.
TAVILY_API_KEY=
# Draft images: "openai" uses the OpenAI Images API; "none" leaves image briefs
IMAGE_PROVIDER=none
IMAGE_API_KEY=
IMAGE_MODEL=gpt-image-1
MAX_IMAGES_PER_DRAFT=4
# Public address of this API server, used for draft image URLs, e.g. https://toolapi.missive.digital
PUBLIC_BASE_URL=
# WordPress draft posts: site URL, a user with Author rights, and that user's Application Password
WP_URL=
WP_USER=
WP_APP_PASSWORD=
