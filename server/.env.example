PORT=5000
DATABASE_URL="mongodb+srv://<username>:<password>@<cluster>.mongodb.net/seo-analyzer?retryWrites=true&w=majority"

# AI Providers (set one or both — Groq is used as fallback if Gemini fails)
AI_PROVIDER=gemini
AI_API_KEY=your_gemini_api_key_here
GROQ_API_KEY=your_groq_api_key_here
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=google/gemini-2.5-flash

# Optional: override model names
# GEMINI_MODEL=gemini-3.7-flash
# GROQ_MODEL=llama-3.3-70b-versatile

CLIENT_URL=http://localhost:5173
RATE_LIMIT_WINDOW_MS=3600000
RATE_LIMIT_MAX_REQUESTS=10
