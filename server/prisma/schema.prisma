generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model Analysis {
  id                String   @id @default(auto()) @map("_id") @db.ObjectId
  content           String
  targetKeyword     String?
  secondaryKeywords String?
  contentType       String
  searchIntent      String?
  overallScore      Int
  seoScore          Int
  intentScore       Int
  depthScore        Int
  readabilityScore  Int
  structureScore    Int
  usefulnessScore   Int
  reportJson        String
  createdAt         DateTime @default(now())
  leads             Lead[]

  @@index([createdAt])
}

model Audit {
  id                   String      @id @default(auto()) @map("_id") @db.ObjectId
  websiteUrl           String
  targetKeyword        String?
  country              String?
  overallScore         Int
  technicalScore       Int
  onPageScore          Int
  contentScore         Int
  performanceScore     Int
  indexabilityScore    Int
  linksScore           Int
  structuredDataScore  Int
  status               String      @default("pending")
  reportJson           String
  createdAt            DateTime    @default(now())
  updatedAt            DateTime    @updatedAt
  pages                AuditPage[]
  issues               AuditIssue[]
  leads                Lead[]

  @@index([createdAt])
  @@index([websiteUrl])
}

model AuditPage {
  id                String   @id @default(auto()) @map("_id") @db.ObjectId
  auditId           String   @db.ObjectId
  audit             Audit    @relation(fields: [auditId], references: [id])
  url               String
  statusCode        Int
  title             String?
  metaDescription   String?
  canonical         String?
  h1Count           Int
  h2Count           Int
  h3Count           Int
  wordCount         Int
  imageCount        Int
  missingAltCount   Int
  internalLinkCount Int
  externalLinkCount Int
  responseTime      Int
  isIndexable       Boolean  @default(true)
  createdAt         DateTime @default(now())

  @@index([auditId])
}

model AuditIssue {
  id             String   @id @default(auto()) @map("_id") @db.ObjectId
  auditId        String   @db.ObjectId
  audit          Audit    @relation(fields: [auditId], references: [id])
  category       String
  severity       String
  title          String
  description    String
  recommendation String
  createdAt      DateTime @default(now())

  @@index([auditId])
  @@index([severity])
}

model KeywordResearch {
  id           String      @id @default(auto()) @map("_id") @db.ObjectId
  seedKeyword  String
  websiteUrl   String?
  country      String?
  language     String?
  businessType String?
  reportJson   String
  createdAt    DateTime    @default(now())
  keywords     Keyword[]
  leads        Lead[]

  @@index([createdAt])
  @@index([seedKeyword])
}

model Keyword {
  id                String          @id @default(auto()) @map("_id") @db.ObjectId
  researchId        String          @db.ObjectId
  research          KeywordResearch @relation(fields: [researchId], references: [id])
  keyword           String
  intent            String
  type              String
  opportunityScore  Int
  businessRelevance Int
  reason            String
  createdAt         DateTime        @default(now())

  @@index([researchId])
}

model ROICalculation {
  id                    String    @id @default(auto()) @map("_id") @db.ObjectId
  currency              String    @default("USD")
  monthlyTraffic        Int
  monthlyLeads          Int?
  averageCustomerValue  Float
  leadToCustomerRate    Float
  organicConversionRate Float
  monthlySeoInvestment  Float
  campaignMonths        Int
  conservativeGrowth    Float
  moderateGrowth        Float
  aggressiveGrowth      Float
  resultJson            String
  createdAt             DateTime  @default(now())
  leads                 Lead[]

  @@index([createdAt])
}

model Lead {
  id                 String            @id @default(auto()) @map("_id") @db.ObjectId
  name               String
  email              String
  company            String?
  website            String?
  phone              String?
  source             String?
  analysisId         String?           @db.ObjectId
  analysis           Analysis?         @relation(fields: [analysisId], references: [id])
  auditId            String?           @db.ObjectId
  audit              Audit?            @relation(fields: [auditId], references: [id])
  researchId         String?           @db.ObjectId
  research           KeywordResearch?  @relation(fields: [researchId], references: [id])
  roiCalculationId   String?           @db.ObjectId
  roiCalculation     ROICalculation?   @relation(fields: [roiCalculationId], references: [id])
  blogTopicId        String?           @db.ObjectId
  blogTopic          BlogTopic?        @relation(fields: [blogTopicId], references: [id])
  topicClusterId     String?           @db.ObjectId
  topicCluster       TopicCluster?     @relation(fields: [topicClusterId], references: [id])
  faqId              String?           @db.ObjectId
  faq                FaqGeneration?    @relation(fields: [faqId], references: [id])
  competitorAnalysisId String?         @db.ObjectId
  competitorAnalysis  CompetitorAnalysis? @relation(fields: [competitorAnalysisId], references: [id])
  contentQaId         String?           @db.ObjectId
  contentQa           ContentQA?        @relation(fields: [contentQaId], references: [id])
  sitemapId           String?           @db.ObjectId
  sitemap             SitemapGeneration? @relation(fields: [sitemapId], references: [id])
  rankCheckId         String?           @db.ObjectId
  rankCheck           RankCheck?        @relation(fields: [rankCheckId], references: [id])
  extractedWebsiteId  String?           @db.ObjectId
  extractedWebsite    ExtractedWebsite? @relation(fields: [extractedWebsiteId], references: [id])
  extractedImagesId   String?           @db.ObjectId
  extractedImages     ExtractedImageProject? @relation(fields: [extractedImagesId], references: [id])
  extractedTechId     String?           @db.ObjectId
  extractedTech       ExtractedTechProject? @relation(fields: [extractedTechId], references: [id])
  socialPlannerId     String?           @db.ObjectId
  socialPlanner       SocialPlannerProject? @relation(fields: [socialPlannerId], references: [id])
  createdAt          DateTime          @default(now())

  @@index([email])
  @@index([createdAt])
}

model BlogTopic {
  id              String   @id @default(auto()) @map("_id") @db.ObjectId
  niche           String
  targetKeywords  String?
  audience        String?
  contentGoal     String
  contentType     String
  topicsJson      String
  strategy        String?
  createdAt       DateTime @default(now())
  leads           Lead[]

  @@index([createdAt])
  @@index([niche])
}

model TopicCluster {
  id                   String   @id @default(auto()) @map("_id") @db.ObjectId
  niche                String
  mainKeyword          String
  audience             String?
  pillarPageJson       String
  clustersJson         String
  interlinkingStrategy String?
  createdAt            DateTime @default(now())
  leads                Lead[]

  @@index([createdAt])
  @@index([mainKeyword])
}

model FaqGeneration {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  topic        String
  keywords     String?
  faqsJson     String
  questionCount Int
  createdAt    DateTime @default(now())
  leads        Lead[]

  @@index([createdAt])
  @@index([topic])
}

model GeneratedLogo {
  id             String   @id @default(auto()) @map("_id") @db.ObjectId
  brandName      String
  description    String?
  industry       String
  style          String   @default("modern")
  primaryColor   String
  secondaryColor String
  svgContent     String
  designJson     String
  createdAt      DateTime @default(now())

  @@index([createdAt])
  @@index([brandName])
}

model CompetitorAnalysis {
  id              String   @id @default(auto()) @map("_id") @db.ObjectId
  competitorUrl   String
  yourUrl         String?
  targetKeywords  String?
  reportJson      String
  createdAt       DateTime @default(now())
  leads           Lead[]

  @@index([createdAt])
  @@index([competitorUrl])
}

model ContentQA {
  id              String   @id @default(auto()) @map("_id") @db.ObjectId
  title           String?
  content         String
  targetKeyword   String?
  metaDescription String?
  urlSlug         String?
  overallScore    Int
  categoryScores  String   // JSON: { objective: number, audience: number, seo: number, ... }
  statuses        String   // JSON: { "obj-1": "pass", "seo-3": "fail", ... }
  reportJson      String?
  createdAt       DateTime @default(now())
  leads           Lead[]

  @@index([createdAt])
}

model SitemapGeneration {
  id              String   @id @default(auto()) @map("_id") @db.ObjectId
  websiteUrl      String?
  totalUrls       Int      @default(0)
  totalImages     Int      @default(0)
  xmlContent      String
  sourceType      String   @default("crawler") // "crawler" | "manual" | "validator"
  settingsJson    String?
  createdAt       DateTime @default(now())
  leads           Lead[]

  @@index([createdAt])
  @@index([websiteUrl])
}

model RankCheck {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  domain       String
  keyword      String
  country      String   @default("US")
  device       String   @default("desktop")
  position     Int?     // 1 to 100, null if outside top 100
  rankingUrl   String?
  resultJson   String   // full SERP results, metrics & outrank playbook
  createdAt    DateTime @default(now())
  leads        Lead[]

  @@index([createdAt])
  @@index([domain])
  @@index([keyword])
}

model ExtractedWebsite {
  id                 String   @id @default(auto()) @map("_id") @db.ObjectId
  websiteUrl         String
  title              String?
  metaDescription    String?
  wordCount          Int      @default(0)
  extractedDataJson  String   // full structured extraction (metadata, headings, contacts, links, markdown)
  aiSummaryJson      String?  // AI entity & executive overview
  createdAt          DateTime @default(now())
  leads              Lead[]

  @@index([createdAt])
  @@index([websiteUrl])
}

model ExtractedImageProject {
  id                 String   @id @default(auto()) @map("_id") @db.ObjectId
  websiteUrl         String
  totalImages        Int      @default(0)
  imagesJson         String   // JSON array of extracted image objects
  statsJson          String?  // JSON summary (formats, missing alt, dimensions)
  createdAt          DateTime @default(now())
  leads              Lead[]

  @@index([createdAt])
  @@index([websiteUrl])
}

model ExtractedTechProject {
  id                 String   @id @default(auto()) @map("_id") @db.ObjectId
  websiteUrl         String
  hostname           String?
  colorsJson         String   // JSON extracted color palette & CSS variables
  techJson           String   // JSON detected tech stack categories
  fontsJson          String   // JSON extracted Google Fonts & typography
  statsJson          String?  // JSON page asset stats & health
  createdAt          DateTime @default(now())
  leads              Lead[]

  @@index([createdAt])
  @@index([websiteUrl])
}

model SocialPlannerProject {
  id                 String   @id @default(auto()) @map("_id") @db.ObjectId
  topic              String
  planType           String   // 'single' | 'sprint_7d' | 'calendar_30d'
  platformsJson      String   // JSON array of selected platforms
  tone               String?
  audience           String?
  postsJson          String   // JSON array of generated posts with hooks & hashtags
  calendarJson       String?  // JSON structured calendar schedule if sprint/calendar
  strategySummary    String?  // Strategic recommendation & pillars breakdown
  createdAt          DateTime @default(now())
  leads              Lead[]

  @@index([createdAt])
  @@index([topic])
}

// ─── Admin & Tool Management ────────────────────────────

model Admin {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  email        String   @unique
  passwordHash String
  name         String
  role         String   @default("admin")
  createdAt    DateTime @default(now())
}

model ToolConfig {
  id              String   @id @default(auto()) @map("_id") @db.ObjectId
  slug            String   @unique
  name            String
  description     String?
  enabled         Boolean  @default(true)
  dailyLimit      Int      @default(100)
  hourlyLimit     Int      @default(20)
  requireEmail    Boolean  @default(true)
  requireName     Boolean  @default(true)
  requirePhone    Boolean  @default(false)
  requireCompany  Boolean  @default(false)
  showLeadPopup   Boolean  @default(false)
  formFields      String   @default("{}") // JSON: { fieldName: { enabled: bool, label: string, required: bool, type: string } }
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}
